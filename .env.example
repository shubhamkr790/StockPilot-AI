# StockPilot AI server config. Never commit this file.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Backup AI provider, used when Gemini is busy. Free key at https://console.groq.com/keys
GROQ_API_KEY=

# Signs login tokens. Any long random string; keep it the same across restarts.
SESSION_SECRET=change-me-to-a-long-random-string
PORT=3001
